{
  "chip_type": "k230",
  "runtime": {
    "name": "nncase_runtime",
    "version": "2.9.0"
  },
  "kmodel_path": "steel_ball_416_motion_v3_nncase_2.9.0.kmodel",
  "labels_path": "labels.txt",
  "input": {
    "name": "images",
    "shape": [
      1,
      3,
      416,
      416
    ],
    "layout": "NCHW",
    "dtype": "float32",
    "color_order": "RGB",
    "preprocess_external": "letterbox to 416x416, fill RGB(114,114,114), bilinear, pixels / 255.0"
  },
  "output": {
    "name": "output0",
    "shape": [
      1,
      10647,
      6
    ],
    "dtype": "float32",
    "format": "raw_yolov5_predictions",
    "fields": [
      "cx",
      "cy",
      "w",
      "h",
      "objectness",
      "Steel_Ball_probability"
    ],
    "strides": [
      8,
      16,
      32
    ],
    "nms_required": true
  },
  "postprocess": {
    "confidence_threshold": 0.25,
    "nms_iou_threshold": 0.45,
    "undo_letterbox": true
  }
}
