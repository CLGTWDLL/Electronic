{
  "chip_type": "k230",
  "runtime": {
    "name": "nncase_runtime",
    "version": "2.9.0"
  },
  "kmodel_path": "steel_ball_full_v2_180_nncase_2.9.0.kmodel",
  "labels_path": "labels.txt",
  "model_type": "YOLOv5RawOutput",
  "num_classes": 1,
  "categories": [
    "Steel_Ball"
  ],
  "inference_width": 640,
  "inference_height": 640,
  "input": {
    "name": "images",
    "shape": [1, 3, 640, 640],
    "layout": "NCHW",
    "dtype": "float32",
    "source_image_decode_order": "BGR if using OpenCV/CanMV image APIs; convert to RGB before tensor conversion",
    "letterbox": {
      "target_wh": [640, 640],
      "fill_value_rgb": [114, 114, 114],
      "resize_interpolation": "bilinear",
      "keep_aspect_ratio": true
    },
    "normalization": "RGB pixel values divided by 255.0"
  },
  "output": {
    "name": "output0",
    "shape": [1, 25200, 6],
    "fields": ["cx", "cy", "w", "h", "objectness", "Steel_Ball_probability"],
    "postprocess": {
      "confidence_threshold": 0.25,
      "nms_iou_threshold": 0.45,
      "nms_required": true,
      "undo_letterbox_before_display": true
    }
  },
  "quantization": {
    "compiler": "nncase 2.9.0 + nncase-kpu 2.9.0",
    "target": "k230",
    "mode": "PTQ",
    "activation": "uint8",
    "weight": "uint8",
    "calibrate_method": "Kld",
    "calibration_images": 100
  }
}
